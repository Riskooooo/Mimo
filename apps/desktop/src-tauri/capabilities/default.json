{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window, the tray menu popup and the panel window",
  "windows": [
    "main",
    "tray-menu",
    "panel",
    "commands",
    "customize"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-size",
    "opener:default"
  ]
}
