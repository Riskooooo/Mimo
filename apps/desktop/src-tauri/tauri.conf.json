{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mimo",
  "mainBinaryName": "Mimo",
  "version": "0.3.0",
  "identifier": "com.fabian.mimo",
  "build": {
    "beforeDevCommand": "npm run setup:voice && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run setup:voice && npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mimo",
        "url": "/",
        "width": 420,
        "height": 84,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "create": false
      },
      {
        "label": "tray-menu",
        "title": "Mimo Menu",
        "url": "/tray-menu",
        "width": 200,
        "height": 222,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "create": false
      },
      {
        "label": "panel",
        "title": "Mimo",
        "url": "/panel",
        "width": 460,
        "height": 680,
        "resizable": false,
        "maximizable": false,
        "minimizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "center": true,
        "visible": false,
        "create": false
      },
      {
        "label": "commands",
        "title": "Mimo",
        "url": "/commands",
        "width": 480,
        "height": 640,
        "resizable": false,
        "maximizable": false,
        "minimizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "center": true,
        "visible": false,
        "create": false
      },
      {
        "label": "customize",
        "title": "Mimo",
        "url": "/customize",
        "width": 440,
        "height": 680,
        "resizable": false,
        "maximizable": false,
        "minimizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "center": true,
        "visible": false,
        "create": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Productivity",
    "shortDescription": "Mimo, a desktop companion for Windows",
    "resources": {
      "resources/vosk": "vosk"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French", "English"],
        "displayLanguageSelector": false
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
